# =====================================================
# PROCESS SINGLE ROW
# =====================================================


def process_row(
        driver,
        wait,
        wb,
        sheet,
        row,
        eik
):


    print()

    print(
        "=========================="
    )


    log(
        f"Processing row {row}"
    )


    log(
        f"EIK: {eik}"
    )



    try:


        open_registry(
            driver
        )



        accept_cookies(
            driver
        )



        search_company(
            driver,
            wait,
            eik
        )



        # Check if company exists


        if not company_found(
            driver
        ):


            log(
                "Company not found."
            )


            write_not_found(
                sheet,
                row
            )


            save_excel(
                wb
            )


            return "NOT FOUND"




        # Open company page


        open_company_page(
            driver,
            wait
        )



        wait_company_data(
            driver,
            wait
        )



        data = extract_data(
            driver
        )



        write_excel(
            sheet,
            row,
            data
        )



        save_excel(
            wb
        )



        close_company_page(
            driver
        )



        log(
            "Row completed successfully."
        )



        return "DONE"




    except Exception as e:


        log(
            f"ERROR processing row {row}: {e}"
        )



        close_company_page(
            driver
        )



        return "ERROR"





# =====================================================
# MAIN
# =====================================================


def main():


    driver, wait = open_browser()



    successful = 0

    not_found = 0

    errors = 0



    start_time = datetime.now()



    try:


        wb, sheet = open_excel()



        rows = get_rows(
            sheet
        )



        log(
            f"Rows prepared: {len(rows)}"
        )



        for counter, (row, eik) in enumerate(rows, start=1):


            result = process_row(
                driver,
                wait,
                wb,
                sheet,
                row,
                eik
            )



            if result == "DONE":

                successful += 1



            elif result == "NOT FOUND":

                not_found += 1



            else:

                errors += 1




            # Autosave


            if counter % SAVE_INTERVAL == 0:


                log(
                    f"Autosave after {counter} rows."
                )


                save_excel(
                    wb
                )



            time.sleep(2)





        # Final save


        save_excel(
            wb
        )



        end_time = datetime.now()



        print()

        print(
            "=========================="
        )


        log(
            "SCRAPER FINISHED"
        )


        log(
            f"Successful: {successful}"
        )


        log(
            f"Not found: {not_found}"
        )


        log(
            f"Errors: {errors}"
        )


        log(
            f"Runtime: {end_time - start_time}"
        )


        print(
            "=========================="
        )



    finally:


        driver.quit()



        log(
            "Browser closed."
        )





# =====================================================
# START PROGRAM
# =====================================================


if __name__ == "__main__":


    main()