# =====================================================


def log(message):

    print(
        f"[{datetime.now():%H:%M:%S}] {message}"
    )



# =====================================================
# BROWSER
# =====================================================


def open_browser():


    log(
        "Opening Edge..."
    )



    options = Options()



    options.add_argument(
        f"--user-data-dir={PROFILE_PATH}"
    )



    options.add_experimental_option(
        "excludeSwitches",
        [
            "enable-logging"
        ]
    )



    driver = webdriver.Edge(
        options=options
    )



    driver.maximize_window()



    wait = WebDriverWait(
        driver,
        30
    )



    log(
        "Edge ready."
    )



    return driver, wait




# =====================================================
# EXCEL
# =====================================================


def open_excel():


    log(
        "Opening Excel..."
    )



    wb = load_workbook(
        EXCEL_FILE
    )



    sheet = wb[
        SHEET_NAME
    ]



    log(
        f"Excel loaded. Rows: {sheet.max_row}"
    )



    return wb, sheet





def save_excel(wb):


    log(
        "Saving Excel..."
    )



    wb.save(
        EXCEL_FILE
    )



    if os.path.exists(EXCEL_FILE):

        log(
            "Excel save successful."
        )

    else:

        log(
            "Excel save FAILED."
        )





# =====================================================
# EIK HANDLING
# =====================================================


def get_eik(sheet, row):


    value = sheet[
        f"{EIK_COLUMN}{row}"
    ].value



    if value is None:

        return None



    return str(
        value
    ).strip()





def get_rows(sheet):


    rows = []



    for row in range(
        START_ROW,
        END_ROW + 1
    ):



        eik = get_eik(
            sheet,
            row
        )



        if eik:


            rows.append(
                (
                    row,
                    eik
                )
            )



    return rows

