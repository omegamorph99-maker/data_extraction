# =====================================================
# COOKIES
# =====================================================


def accept_cookies(driver):


    try:


        button = WebDriverWait(
            driver,
            5
        ).until(
            EC.element_to_be_clickable(
                (
                    By.CSS_SELECTOR,
                    "#cookieInfo button"
                )
            )
        )



        button.click()



        log(
            "Cookies accepted."
        )



    except:


        log(
            "Cookie popup not shown."
        )





# =====================================================
# SEARCH COMPANY
# =====================================================


def search_company(driver, wait, eik):


    log(
        f"Searching company {eik}"
    )



    # Select Legal Entity


    wait.until(
        EC.element_to_be_clickable(
            (
                By.CSS_SELECTOR,
                "label[for='CompanyFormId']"
            )
        )
    ).click()



    # EIK field


    field = wait.until(
        EC.presence_of_element_located(
            (
                By.ID,
                "searchCriteria_ident"
            )
        )
    )



    field.clear()



    field.send_keys(
        eik
    )



    # Search button


    wait.until(
        EC.element_to_be_clickable(
            (
                By.XPATH,
                "//button[contains(.,'Search')]"
            )
        )
    ).click()



    log(
        "Search submitted."
    )





# =====================================================
# CHECK SEARCH RESULT
# =====================================================


def company_found(driver):


    try:


        WebDriverWait(
            driver,
            10
        ).until(
            EC.presence_of_element_located(
                (
                    By.XPATH,
                    "//a[contains(@href,'ActiveConditionTabResult')]"
                )
            )
        )



        return True



    except TimeoutException:


        return False





# =====================================================
# OPEN COMPANY RESULT
# =====================================================


def open_company_page(driver, wait):


    log(
        "Opening company page..."
    )



    old_tabs = driver.window_handles



    link = wait.until(
        EC.element_to_be_clickable(
            (
                By.XPATH,
                "//a[contains(@href,'ActiveConditionTabResult')]"
            )
        )
    )



    link.click()



    # Wait for new tab


    wait.until(
        lambda d:
        len(d.window_handles) > len(old_tabs)
    )



    new_tab = [

        tab

        for tab in driver.window_handles

        if tab not in old_tabs

    ][0]



    driver.switch_to.window(
        new_tab
    )



    wait.until(
        lambda d:
        "ActiveConditionTabResult"
        in d.current_url
    )



    log(
        "Company URL loaded."
    )


    log(
        driver.current_url
    )

