# =====================================================
# WAIT FOR COMPANY DATA
# =====================================================


def wait_company_data(driver, wait):


    log(
        "Waiting for company data..."
    )



    wait.until(
        EC.presence_of_element_located(
            (
                By.CLASS_NAME,
                "record-container--preview"
            )
        )
    )



    log(
        "Company data loaded."
    )





# =====================================================
# EXTRACT COMPANY DATA
# =====================================================


def extract_data(driver):


    log(
        "Extracting company fields..."
    )



    containers = driver.find_elements(
        By.CLASS_NAME,
        "record-container--preview"
    )



    texts = []



    for container in containers:


        text = container.text.strip()



        if text:


            texts.append(
                text
            )



    full_text = "\n".join(
        texts
    )



    data = {


        "phone": "",


        "fax": "",


        "email": "",


        "website": ""


    }





    # -----------------------------
    # PHONE
    # -----------------------------


    phone = re.search(
        r"Phone\s*:?\s*([^\n]+)",
        full_text,
        re.IGNORECASE
    )



    if phone:


        data["phone"] = (
            phone.group(1)
            .strip()
        )





    # -----------------------------
    # FAX
    # -----------------------------


    fax = re.search(
        r"Fax\s*:?\s*([^\n]+)",
        full_text,
        re.IGNORECASE
    )



    if fax:


        data["fax"] = (
            fax.group(1)
            .strip()
        )





    # -----------------------------
    # EMAIL
    # -----------------------------


    email = re.search(
        r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}",
        full_text
    )



    if email:


        data["email"] = (
            email.group(0)
            .strip()
        )





    # -----------------------------
    # WEBSITE
    # -----------------------------


    website = re.search(
        r"(https?://[^\s]+|www\.[^\s]+)",
        full_text
    )



    if website:


        data["website"] = (
            website.group(0)
            .strip()
        )





    print()


    print(
        "========== EXTRACTED DATA =========="
    )


    print(
        data
    )


    print(
        "===================================="
    )



    return data





