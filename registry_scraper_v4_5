# =====================================================
# WRITE COMPANY DATA
# =====================================================


def write_excel(sheet, row, data):


    log(
        f"Writing Excel row {row}"
    )



    sheet[
        f"{PHONE_COLUMN}{row}"
    ] = data.get(
        "phone",
        ""
    )



    sheet[
        f"{FAX_COLUMN}{row}"
    ] = data.get(
        "fax",
        ""
    )



    sheet[
        f"{EMAIL_COLUMN}{row}"
    ] = data.get(
        "email",
        ""
    )



    sheet[
        f"{WEBSITE_COLUMN}{row}"
    ] = data.get(
        "website",
        ""
    )



    sheet[
        f"{STATUS_COLUMN}{row}"
    ] = "DONE"




    print()


    print(
        "Values written:"
    )


    print(
        f"Phone: {data.get('phone','')}"
    )


    print(
        f"Fax: {data.get('fax','')}"
    )


    print(
        f"Email: {data.get('email','')}"
    )


    print(
        f"Website: {data.get('website','')}"
    )





# =====================================================
# WRITE NOT FOUND
# =====================================================


def write_not_found(sheet, row):


    log(
        f"Writing NOT FOUND for row {row}"
    )



    sheet[
        f"{PHONE_COLUMN}{row}"
    ] = ""



    sheet[
        f"{FAX_COLUMN}{row}"
    ] = ""



    sheet[
        f"{EMAIL_COLUMN}{row}"
    ] = ""



    sheet[
        f"{WEBSITE_COLUMN}{row}"
    ] = ""



    sheet[
        f"{STATUS_COLUMN}{row}"
    ] = "NOT FOUND"





# =====================================================
# STATUS CHECK
# =====================================================


def is_completed(sheet, row):


    status = sheet[
        f"{STATUS_COLUMN}{row}"
    ].value



    if status == "DONE":

        return True



    return False

